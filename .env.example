# Copy to .env and fill in. Never commit the real .env.
# live = real WhatsApp link via Baileys; mock = local test adapter, no WhatsApp.
MODE=live
HOST=127.0.0.1
PORT=3000

# Password for the bridge page login. On AWS this is pulled from SSM Parameter
# Store by the user-data script, not written here by hand.
BRIDGE_PASSWORD=change-me

# The single chat the bridge relays, as a WhatsApp JID:
# country code + number, no + or spaces, e.g. 14155551234@s.whatsapp.net
ALLOWED_CHAT_JID=

# Your own WhatsApp number, digits only with country code (e.g. 14155551234).
# Enables "Link with phone number" codes on the bridge page.
# Leave empty to offer QR scanning only.
PAIRING_PHONE=

# Bridge timing, in hours (chosen at launch, not changeable from the page):
# SETUP_HOURS=2       # 0.25-12: time allowed to link before the bridge closes
# SESSION_HOURS=24    # 1-168: hours of access after linking
# Values outside those ranges are rejected at render time and clamped at boot.
# Raw millisecond overrides (take precedence if both are set):
# SETUP_WINDOW_MS=7200000
# ACCESS_WINDOW_MS=86400000
